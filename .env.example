DATABASE_URL=postgresql+psycopg://resolveai:resolveai@localhost:5433/resolveai
JWT_SECRET=change-me-with-a-random-secret-at-least-32-characters
JWT_TTL_MINUTES=480
DEMO_USER_EMAIL=demo@resolveai.local
DEMO_USER_PASSWORD=change-me-demo-password
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=800
EMBEDDING_BATCH_SIZE=64
LLM_PRICING_FILE=
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.25
CONTEXT_TOKEN_BUDGET=3000
RATE_LIMIT_PER_MINUTE=30
DAILY_BUDGET_USD=1.0

# Data retention in days; 0 keeps the records forever. The worker deletes what is older.
# Documents are never deleted automatically.
RETENTION_INCIDENT_DAYS=0
RETENTION_CONVERSATION_DAYS=0
RETENTION_LOG_DAYS=0
RETENTION_AUDIT_DAYS=0
# Upload hardening. OCR needs tesseract and pdftoppm on the PATH (the Docker image has both).
OCR_ENABLED=true
OCR_LANGUAGES=eng
OCR_MAX_PAGES=50
# Malware scan: start ClamAV with `--profile scan` and set CLAMAV_HOST=clamav.
# Once set, an upload that cannot be scanned is refused.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Accounts. The first account on an empty install becomes the administrator.
ALLOW_REGISTRATION=true
# Public address of the web app, used in password reset links.
APP_URL=http://localhost:3000
# Password reset by email. Without SMTP_HOST an administrator issues reset links instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=resolveai@localhost
# Single sign-on (OpenID Connect). Off until all three are set.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Ingestion. Compose runs a separate worker and sets INGEST_INLINE=false for the API.
INGEST_INLINE=true
INGEST_MAX_ATTEMPTS=3
INGEST_LOCK_MINUTES=15

# Production overlay (infra/docker-compose.prod.yml, see docs/deployment.md).
# SITE_ADDRESS=resolveai.example.com
# Prometheus scrape token for GET /metrics on the API; the endpoint is off while this is empty.
METRICS_TOKEN=
# Error reports go to Sentry only when a DSN is set.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# Keyless local demo:
# LLM_PROVIDER=mock
# EMBEDDING_PROVIDER=mock
# EMBEDDING_DIM=256
# Anthropic chat with OpenAI embeddings:
# LLM_PROVIDER=anthropic
# EMBEDDING_PROVIDER=openai
# OLLAMA_BASE_URL=http://ollama:11434
